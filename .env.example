# Resend API key — hae resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx

# Yhteydenottolomakkeen vastaanottaja — vain palvelimella, ei päädy selaimeen
CONTACT_EMAIL=example@example.com

# Sivulla näytettävä osoite (renderöidään selaimessa, ei palvelimen HTML:ssä).
# Voi olla eri kuin CONTACT_EMAIL, jos näytettävä osoite halutaan joskus hylätä roskapostin takia.
NEXT_PUBLIC_CONTACT_EMAIL=example@example.com

# Upstash Redis — kestävä rate limit yli serverless-instanssien.
# Luo ilmainen tietokanta console.upstash.com. Jos nämä puuttuvat, käytössä on
# muistinvarainen varajärjestelmä (riittää paikalliseen kehitykseen).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
